###############################################################################
# Context Compaction Proxy — configuration
# Copy this file to ".env" in the SAME directory as app.py (your Docker mount).
# Existing OS / Compose environment variables win over this file.
#
# Clients:
#   OpenAI-compatible (Continue, Open WebUI OpenAI mode):
#     base URL -> http://<proxy-host>:11435/v1
#   Native Ollama (Continue Ollama provider, Open WebUI Ollama mode):
#     base URL -> http://<proxy-host>:11435
###############################################################################


# =============================================================================
# 1) LISTEN ADDRESS
# =============================================================================
# Interface and port the proxy binds to inside the container / host.
PROXY_HOST=0.0.0.0
PROXY_PORT=11435


# =============================================================================
# 2) BACKENDS
#    Chat traffic is routed by the URL the CLIENT used, not by model name.
#      /v1/*            -> LLAMASWAP_URL   (OpenAI-compatible: llama-swap, etc.)
#      /api/*           -> OLLAMA_URL      (native Ollama)
#    No trailing slash required. /v1 on llama-swap is optional; both work.
# =============================================================================
LLAMASWAP_URL=http://arceus:9931/v1
OLLAMA_URL=http://ollama:11434


# =============================================================================
# 3) CONTEXT MATH
#    Used only to decide WHEN to compact. Not sent as tokenizer config.
# =============================================================================
# Fallback context window when the client does not send num_ctx.
DEFAULT_MODEL_CTX_TOKENS=131072

# Characters per token for trigger math.
# 2.55 is calibrated to llama-swap infill (~1% error). Do NOT set this to 4
# unless you have measured that tokenizer; 4 fires compact far too late on
# code / tool dumps.
CHARS_PER_TOKEN=2.55

# Fractions of (num_ctx * CHARS_PER_TOKEN):
#   TRIGGER_RATIO        compact when effective payload exceeds this
#   ACTIVE_RATIO         keep this much recent history unsummarized
#   SUMMARY_RATIO        target size of the persistent summary
#   CHUNK_RATIO          max size of each multi-pass compact bite
#   TOOL_TRUNCATE_RATIO  max size of a single tool result before head/tail trim
TRIGGER_RATIO=0.80
ACTIVE_RATIO=0.45
SUMMARY_RATIO=0.12
CHUNK_RATIO=0.25
TOOL_TRUNCATE_RATIO=0.05

# When the proxy is allowed to rewrite tool-result messages (truncate oversized
# bodies, replace duplicate tool payloads with a short notice).
#   compact_only  (default) rewrite ONLY after a compact fires — live turns
#                 keep original tool text so llama.cpp prefix cache survives
#                 long tool-call storms. Compact already rebuilds the prefix.
#   always        rewrite on every request (max token savings; a new duplicate
#                 or a tool that newly exceeds the limit changes earlier
#                 messages and invalidates KV cache)
#   never         never rewrite forwarded tool results
# Aliases: true/on/1 -> always; false/off/0 -> never.
TOOL_OUTPUT_MUTATIONS=compact_only


# =============================================================================
# 4) SUMMARIZER
#    Two modes:
#
#    A) Named model (recommended for latency / VRAM isolation)
#         SUMMARY_MODEL=qwen2.5:3b
#         SUMMARY_BACKEND=ollama          # ollama | llamaswap
#         SUMMARY_URL=                    # leave empty to use OLLAMA_URL or
#                                         # LLAMASWAP_URL for that backend
#
#    B) Follow the live chat model ("auto")
#         SUMMARY_MODEL=auto
#         Compact uses the request's model on the SAME backend the client hit.
#         /v1 chat  + auto -> llama-swap + that chat model
#         /api chat + auto -> Ollama     + that chat model
#         WARNING: auto on a 70B coder will block the request for the compact.
# =============================================================================
SUMMARY_MODEL=qwen2.5:3b
SUMMARY_BACKEND=ollama
SUMMARY_URL=

# HTTP wait per compact call, in seconds. 0 = wait forever (no socket timeout).
# This is NOT model residency. A hung backend will block the client this long.
COMPACT_TIMEOUT=900

# How long the SUMMARIZER stays loaded after a compact call.
#   Ollama: sent as keep_alive.  0 = unload as soon as the call finishes.
#   llama-swap: forwarded as keep_alive / options.keep_alive when supported.
# Set 0 if loading a small model beside your primary llama-swap model tanks tok/s.
SUMMARY_KEEP_ALIVE=0

# After the last compact pass, also hit an explicit unload endpoint so the
# primary model can reclaim VRAM before the user's completion is forwarded.
# Keep true when SUMMARY_KEEP_ALIVE=0.
UNLOAD_SUMMARY_AFTER_COMPACT=true


# =============================================================================
# 5) CACHE
#    SQLite file lives on the app.py mount so it survives container restarts.
#    Leave CACHE_DB empty to use ./proxy_cache.db next to app.py.
# =============================================================================
CACHE_DB=
MAX_CHATS=50


# =============================================================================
# 6) OPTIONAL POLICY INJECTION  (OFF by default — keep it off for Continue /
#    generic Open WebUI / any client that should not see Engraphis text)
#
#    When true, the proxy appends SYSTEM_DIRECTIVE (or a built-in Engraphis
#    block if SYSTEM_DIRECTIVE is empty) to the synthetic SYSTEM prompt —
#    the same prefix every non-compact turn, so llama.cpp KV can extend.
#    User messages are left untouched (last-user inject moved every turn and busted cache).
# =============================================================================
INJECT_SYSTEM_DIRECTIVE=false
SYSTEM_DIRECTIVE=
